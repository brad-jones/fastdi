{
  // Try and keep things less than 80 but we all have widescreens these days so 120 should be sweet
  "editor.rulers": [80, 120],
  "editor.renderWhitespace": "boundary",

  // Setup dprint as the default formatter for all supported languages
  // We need to explcitly define all language specfic settings
  // see: https://github.com/microsoft/vscode/issues/107184
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "dprint.dprint",
  "[json]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[toml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[markdown]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[python]": {
    "editor.defaultFormatter": "dprint.dprint"
  },

  // Trust json schemas from anywhere, what harm could they do?
  "json.schemaDownload.trustedDomains": {
    "*": true
  },

  // Associate .gitmsgtpl files with the git-commit language for syntax highlighting
  "files.associations": {
    "*.gitmsgtpl": "git-commit"
  },

  // Don't automatically activate the venv in the terminal, we control that ourselves through pixi config.
  "python.terminal.activateEnvironment": false,
  "python.terminal.useEnvFile": false,

  // Make VsCode use bash instead of non POSIX compliant shells like fish
  "terminal.integrated.automationProfile.linux": {
    "path": "/bin/bash"
  },

  // Make CoPilot use bash instead of non POSIX compliant shells like fish.
  // Also silence direnv's "loading"/"export" chatter in this profile only,
  // since it clutters tool output and confuses agents. Requires a
  // ~/.config/direnv/direnv.toml to exist (any content) for direnv >=2.36 to
  // honor DIRENV_LOG_FORMAT at all - see the comment in .envrc.
  "chat.tools.terminal.terminalProfile.linux": {
    "path": "/bin/bash",
    "env": {
      "DIRENV_LOG_FORMAT": ""
    }
  },

  // *nix OSes work well with https://direnv.net/
  // https://pixi.prefix.dev/latest/integration/editor/vscode/#direnv-extension
  // But direnv support on Windows is buggy, instead this custom terminal profile works for Windows users.
  "terminal.integrated.profiles.windows": {
    "Powershell (pixi)": {
      "path": "powershell.exe",
      "args": [
        "-NoExit",
        "-Command",
        "pixi shell"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "Powershell (pixi)"
}
