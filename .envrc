# see: https://pixi.prefix.dev/latest/integration/third_party/direnv/
watch_file pixi.lock
eval "$(pixi shell-hook)"
dotenv_if_exists .env

# `task init` is idempotent (Task's own checksum cache already skips real work
# when nothing changed) but even a no-op run costs time and prints "up to
# date" noise into every new shell, which is unnecessary and confuses AI
# agents. Its dependency files (apm.lock.yaml, lefthook.yaml, uv.lock,
# .apm/**) only change via `git pull`, so gate the whole invocation on HEAD
# having moved since the last successful run. If you edit one of those files
# locally without committing, run `task init` manually to pick it up.
task_init_cache=".task/direnv-init-head"
head_sha="$(git rev-parse HEAD 2>/dev/null)"
if [[ -z "$head_sha" || "$head_sha" != "$(cat "$task_init_cache" 2>/dev/null)" ]]; then
  task init && mkdir -p "$(dirname "$task_init_cache")" && echo "$head_sha" >"$task_init_cache"
fi

# direnv itself also prints "direnv: loading ..." / "direnv: export ..." on
# every load, independent of the noise task init used to add above. This repo
# can't silence that for you: direnv reads DIRENV_LOG_FORMAT from the
# environment *before* .envrc runs, so exporting it in here only affects the
# next reload in the same shell, not the current one. VS Code's Copilot Chat
# terminal profile in .vscode/settings.json sets DIRENV_LOG_FORMAT="" for
# that one profile, which covers Copilot in VS Code. Terminal-based agents
# (Claude Code, Copilot CLI) run in your normal login shell instead, so
# there's no per-repo hook to catch them - the fix has to live in your own
# shell rc, guarded on an agent-detection env var so it doesn't also silence
# direnv for you as a human. If you want that, add to your shell rc, before
# the `direnv hook` line:
#
#   # fish (~/.config/fish/conf.d/direnv-hook.fish), before `direnv hook fish | source`:
#   if set -q CLAUDECODE; or set -q COPILOT_CLI; or set -q COPILOT_AGENT
#     set -gx DIRENV_LOG_FORMAT ""
#   end
#
#   # bash/zsh, before `eval "$(direnv hook bash)"`:
#   if [[ -n "$CLAUDECODE" || -n "$COPILOT_CLI" || -n "$COPILOT_AGENT" ]]; then
#     export DIRENV_LOG_FORMAT=""
#   fi
#
# This also requires a `~/.config/direnv/direnv.toml` (any content, even
# empty) to exist: direnv >=2.36 only reads DIRENV_LOG_FORMAT from the
# environment when that file is present (see
# https://github.com/direnv/direnv/issues/68#issuecomment-2812015043).

